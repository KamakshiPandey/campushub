PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (Defaults to SQLite for instant zero-config setup; set DB_DIALECT=mysql and provide DB credentials to use MySQL)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# MySQL Config (uncomment and configure if using MySQL)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=campushub_db
# DB_USER=root
# DB_PASSWORD=rootpassword

JWT_SECRET=super_secret_campushub_jwt_key_2026
JWT_EXPIRE=30d

# Email SMTP Config (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=no-reply@campushub.com
FROM_NAME=CampusHub Team
